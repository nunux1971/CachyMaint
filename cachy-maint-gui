    def show_hardware(self, sections: list):
        self.hw_sections = sections
        self.hw_tree.clear()
        self.hw_sensor_item = None
        bold = self.hw_tree.font()
        bold.setBold(True)
        for title, ic, rows in sections:
            top = QTreeWidgetItem(self.hw_tree, [title, ""])
            top.setIcon(0, icon(ic, "computer"))
            top.setFont(0, bold)
            top.setFirstColumnSpanned(True)
            self._fill(top, rows)
            top.setExpanded(title != "Périphériques USB")
            if title == "Capteurs":
                self.hw_sensor_item = top

    def _fill(self, parent: QTreeWidgetItem, rows: list):
        last = parent
        for k, v in rows:
            if k.startswith("   "):          # sous-ligne rattachée à la précédente
                QTreeWidgetItem(last, [k.strip(), v])
                last.setExpanded(True)
            else:
                last = QTreeWidgetItem(parent, [k, v])
                last.setToolTip(1, v)

    def update_sensors(self):
        if not self.hw_sensor_item or not self.isVisible():
            return
        rows = hw_sensors()
        self.hw_sensor_item.takeChildren()
        self._fill(self.hw_sensor_item, rows)
        for i, (title, ic, _) in enumerate(self.hw_sections):
            if title == "Capteurs":
                self.hw_sections[i] = (title, ic, rows)
        for i in range(self.hw_sensor_item.childCount()):
            it = self.hw_sensor_item.child(i)
            m = re.match(r"([\d.]+) °C", it.text(1))
            if m:
                t = float(m.group(1))
                it.setForeground(1, QColor(RED if t >= 85 else ORANGE if t >= 70 else GREEN))

