def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def sh(cmd, timeout: int = 60) -> tuple[int, str]:
    """Exécute une commande (liste ou chaîne shell) et renvoie (code, sortie)."""
    env = dict(os.environ, LC_ALL="C")
    try:
        p = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True,
                           text=True, timeout=timeout, env=env)
        return p.returncode, p.stdout
    except (OSError, subprocess.SubprocessError):
        return 1, ""


def human(n: float | None) -> str:
    if n is None:
        return "?"
    for unit in ("o", "Ko", "Mo", "Go", "To"):
        if abs(n) < 1024 or unit == "To":
            return f"{n:.0f} {unit}" if unit in ("o", "Ko") else f"{n:.1f} {unit}"
        n /= 1024
    return "?"


def dir_size(path: Path | str) -> int | None:
    if not Path(path).exists():
        return 0
    _, out = sh(["du", "-sb", str(path)], timeout=120)
    try:
        return int(out.split()[0])
    except (IndexError, ValueError):
        return None


def fmt_duration(seconds: float) -> str:
    d, rem = divmod(int(seconds), 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    parts = ([f"{d} j"] if d else []) + ([f"{h} h"] if h else []) + [f"{m} min"]
    return " ".join(parts)


def aur_helper() -> str | None:
    return next((h for h in ("paru", "yay") if have(h)), None)


def find_terminal() -> list[str] | None:
    for name, args in (("konsole", ["konsole", "-e"]), ("kitty", ["kitty"]),
                       ("alacritty", ["alacritty", "-e"]), ("ghostty", ["ghostty", "-e"]),
                       ("wezterm", ["wezterm", "start", "--"]), ("foot", ["foot"]),
                       ("gnome-terminal", ["gnome-terminal", "--"]),
                       ("xfce4-terminal", ["xfce4-terminal", "-x"]), ("xterm", ["xterm", "-e"])):
        if have(name):
            return args
    return None


def log_line(text: str) -> None:
    try:
        with LOG.open("a", encoding="utf-8") as f:
            f.write(f"[{dt.datetime.now():%F %T}] {text.rstrip()}\n")
    except OSError:
        pass


UPD_RE = re.compile(r"^(\S+)\s+(\S+)\s+->\s+(\S+)")
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def parse_updates(text: str, source: str) -> list[tuple[str, str, str, str]]:
    res = []
    for line in text.splitlines():
        m = UPD_RE.match(line.strip())
        if m:
            res.append((m.group(1), m.group(2), m.group(3), source))
    return res


