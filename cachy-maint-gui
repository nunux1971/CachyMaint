def hardware_report(sections) -> str:
    out = [f"Rapport matériel — {APP_NAME} {VERSION} — {dt.datetime.now():%d/%m/%Y %H:%M}", ""]
    for title, _, rows in sections:
        out.append(f"{title}:")
        width = max((len(k.strip()) for k, _ in rows), default=0)
        for k, v in rows:
            indent = "      " if k.startswith("   ") else "  "
            out.append(f"{indent}{k.strip():<{width}}  {v}")
        out.append("")
    return "\n".join(out)


