SMART_CACHE = STATE / "smart.json"

# Attributs ATA dont la valeur normalisée = % de vie restante (selon les fabricants)
ATA_LIFE_ATTRS = (231, 202, 169, 177, 233, 173)


def _ata_attrs(j: dict) -> dict[int, dict]:
    return {a.get("id"): a for a in j.get("ata_smart_attributes", {}).get("table", [])}


def _raw(a: dict | None) -> int:
    try:
        return int((a or {}).get("raw", {}).get("value", 0))
    except (TypeError, ValueError):
        return 0


def fmt_hours(h: int) -> str:
    if h < 48:
        return f"{h} h"
    y, d = divmod(h / 24, 365)
    return f"{h:,} h (≈ {y:.0f} an{'s' if y >= 2 else ''} {d:.0f} j)".replace(",", " ") if y \
        else f"{h:,} h (≈ {d:.0f} jours)".replace(",", " ")


def fmt_tb(n: float) -> str:
    return f"{n / 1e12:.2f} To" if n >= 1e12 else f"{n / 1e9:.0f} Go"


def analyze_smart(dev: str, j: dict) -> dict:
    """Résume la sortie JSON de smartctl en verdict + lignes lisibles."""
    r = {"dev": dev, "model": j.get("model_name") or j.get("model_family") or "Disque",
         "capacity": (j.get("user_capacity") or {}).get("bytes") or j.get("nvme_total_capacity"),
         "health": None, "level": "ok", "reasons": [], "rows": []}
    proto = (j.get("device") or {}).get("protocol", "")
    if not j or "smart_status" not in j and proto != "NVMe" and not j.get("ata_smart_attributes"):
        msgs = [m.get("string", "") for m in (j.get("smartctl") or {}).get("messages", [])]
        r.update(kind="?", level="info", verdict="SMART non disponible",
                 reasons=[m for m in msgs if m][:2] or ["Ce périphérique ne fournit pas de données SMART "
                                                        "(clé USB, disque virtuel, adaptateur…)."])
        return r
    rot = j.get("rotation_rate", 0)
    r["kind"] = "NVMe" if proto == "NVMe" else ("HDD" if isinstance(rot, int) and rot > 0 else "SSD")
    rows, reasons = r["rows"], r["reasons"]
    bad = warn = False

    passed = (j.get("smart_status") or {}).get("passed")
    if passed is False:
        bad = True
        reasons.append("Le disque signale lui-même une défaillance SMART.")
    temp = (j.get("temperature") or {}).get("current")
    hours = (j.get("power_on_time") or {}).get("hours")

    if proto == "NVMe":
        n = j.get("nvme_smart_health_information_log", {})
        used = n.get("percentage_used")
        if used is not None:
            r["health"] = max(0, 100 - int(used))
        spare, thr = n.get("available_spare"), n.get("available_spare_threshold")
        if spare is not None:
            rows.append(("Réserve disponible", f"{spare} % (seuil {thr} %)"))
            if thr is not None and spare <= thr:
                bad = True
                reasons.append("Réserve de cellules sous le seuil critique.")
            elif spare < 50:
                warn = True
                reasons.append("Réserve de cellules entamée.")
        written = n.get("data_units_written", 0) * 512000
        read_ = n.get("data_units_read", 0) * 512000
        rows.append(("Données écrites", fmt_tb(written)))
        rows.append(("Données lues", fmt_tb(read_)))
        if n.get("critical_warning"):
            bad = True
            reasons.append(f"Avertissement critique du contrôleur (code {n['critical_warning']}).")
        me = n.get("media_errors", 0)
        rows.append(("Erreurs de données", str(me)))
        if me:
            warn = True
            reasons.append(f"{me} erreur(s) d'intégrité des données.")
        rows.append(("Arrêts brutaux", str(n.get("unsafe_shutdowns", 0))))
        hours = hours or n.get("power_on_hours")
        temp = temp or n.get("temperature")
    else:
        attrs = _ata_attrs(j)
        if r["kind"] == "SSD":
            for i in ATA_LIFE_ATTRS:
                if i in attrs and attrs[i].get("value") is not None:
                    r["health"] = max(0, min(100, int(attrs[i]["value"])))
                    break
        for a in attrs.values():
            name = a.get("name", "")
            if re.search(r"(Total_LBAs_Written|Host_Writes|Lifetime_Writes|NAND_Writes)", name):
                raw = _raw(a)
                unit = (2 ** 30 if "GiB" in name else 32 * 2 ** 20 if "32MiB" in name
                        else j.get("logical_block_size", 512))
                rows.append(("Données écrites", fmt_tb(raw * unit)))
                break
        for aid, label, severe in ((5, "Secteurs réalloués", False), (197, "Secteurs en attente", True),
                                   (198, "Secteurs illisibles", True), (199, "Erreurs de câble (CRC)", False)):
            if aid in attrs:
                v = _raw(attrs[aid])
                rows.append((label, str(v)))
                if v:
                    if severe or (aid == 5 and v > 50):
                        bad = True
                    else:
                        warn = True
                    reasons.append(f"{label} : {v}" + (" — vérifie le câble SATA." if aid == 199 else "."))
        for a in attrs.values():
            if a.get("thresh") and a.get("value") is not None and a["value"] <= a["thresh"]:
                bad = True
                reasons.append(f"Attribut {a.get('name')} sous son seuil de défaillance.")

    h = r["health"]
    if h is not None:
        if h <= 10:
            bad = True
            reasons.append(f"Usure très avancée : {h} % de vie restante.")
        elif h <= 30:
            warn = True
            reasons.append(f"Usure avancée : {h} % de vie restante.")
    if temp:
        rows.insert(0, ("Température", f"{temp} °C"))
        if temp >= 70:
            warn = True
            reasons.append(f"Température élevée ({temp} °C) : vérifie la ventilation / le dissipateur.")
    if hours is not None:
        rows.insert(0, ("Heures de fonctionnement", fmt_hours(int(hours))))
    if j.get("power_cycle_count") is not None:
        rows.insert(1, ("Démarrages", str(j["power_cycle_count"])))

    test = None
    if proto == "NVMe":
        t = (j.get("nvme_self_test_log") or {}).get("table") or []
        if t:
            test = (t[0].get("self_test_result") or {}).get("string")
    else:
        t = ((j.get("ata_smart_self_test_log") or {}).get("standard") or {}).get("table") or []
        if t:
            test = (t[0].get("status") or {}).get("string")
    if test:
        rows.append(("Dernier auto-test", test))
        if re.search(r"fail", test, re.I):
            bad = True
            reasons.append(f"Le dernier auto-test a échoué : {test}")
    if j.get("firmware_version"):
        rows.append(("Firmware", j["firmware_version"]))

    r["level"] = "bad" if bad else ("warn" if warn else "ok")
    r["verdict"] = {"bad": "Critique — sauvegarde tes données", "warn": "À surveiller",
                    "ok": "Bon état"}[r["level"]]
    if not reasons:
        reasons.append("Aucun signe d'usure anormale ni d'erreur.")
    return r


def parse_smart_output(text: str) -> list[dict]:
    import json
    disks = []
    for block in text.split("@@@ ")[1:]:
        dev, _, js = block.partition("\n")
        try:
            j = json.loads(js.strip() or "{}")
        except ValueError:
            j = {}
        disks.append(analyze_smart(dev.strip(), j))
    return disks


