    def load_smart_cache(self):
        import json
        try:
            c = json.loads(SMART_CACHE.read_text())
            self.show_disks(c["disks"], c["date"])
        except (OSError, ValueError, KeyError):
            self.smart_info.setText("Aucune analyse pour l'instant : clique sur « Analyser les disques ».")

    def analyze_disks(self):
        if not Path(HELPER).exists():
            QMessageBox.warning(self, APP_NAME, "Le module administrateur n'est pas installé. "
                                                "Lance install.sh.")
            return
        if self._smart_proc:
            return
        self.smart_btn.setEnabled(False)
        self.smart_info.setText("Analyse en cours…")
        p = QProcess(self)
        p.finished.connect(self._smart_done)
        self._smart_proc = p
        p.start("pkexec", [HELPER, "smart-json"])

    def _smart_done(self, code: int, _status):
        import json
        p, self._smart_proc = self._smart_proc, None
        self.smart_btn.setEnabled(True)
        out = bytes(p.readAllStandardOutput()).decode("utf-8", "replace")
        p.deleteLater()
        if code in (126, 127):
            self.smart_info.setText("Analyse annulée (authentification refusée).")
            return
        if "@@@" not in out:
            self.smart_info.setText("Analyse impossible : " + (out.strip()[:200] or f"code {code}"))
            return
        disks = parse_smart_output(out)
        date = f"{dt.datetime.now():%d/%m/%Y à %H:%M}"
        try:
            SMART_CACHE.write_text(json.dumps({"date": date, "disks": disks}))
        except OSError:
            pass
        self.show_disks(disks, date)
        for d in disks:
            log_line(f"SMART {d['dev']} {d['model']} : {d['verdict']} (vie {d['health']})")

    def show_disks(self, disks: list, date: str):
        self.smart_disks, self.smart_date = disks, date
        while self.smart_grid.count():
            it = self.smart_grid.takeAt(0)
            if it.widget():
                it.widget().deleteLater()
        for i, d in enumerate(disks):
            self.smart_grid.addWidget(self.disk_card(d), i // 2, i % 2)
        self.smart_info.setText(f"Dernière analyse : {date} — {len(disks)} disque(s).")
        self.update_dash_smart()

    def disk_card(self, d: dict) -> QFrame:
        col = {"ok": GREEN, "warn": ORANGE, "bad": RED}.get(d["level"], BLUE)
        f = QFrame()
        f.setFrameShape(QFrame.Shape.StyledPanel)
        f.setStyleSheet(f"QFrame#disk {{ border-left: 4px solid {col}; }}")
        f.setObjectName("disk")
        v = QVBoxLayout(f)
        head = QHBoxLayout()
        ic = QLabel()
        ic.setPixmap(icon("drive-harddisk-solidstate" if d.get("kind") in ("SSD", "NVMe")
                          else "drive-harddisk", "drive-harddisk").pixmap(36, 36))
        head.addWidget(ic)
        cap = human(d["capacity"]) if d.get("capacity") else ""
        head.addWidget(QLabel(f"<b>{html.escape(d['model'])}</b><br><small>{d['dev']} • "
                              f"{d.get('kind', '?')}{' • ' + cap if cap else ''}</small>"), 1)
        verdict = QLabel(html.escape(d["verdict"]))
        verdict.setStyleSheet(f"color:{col}; font-weight:bold")
        head.addWidget(verdict)
        v.addLayout(head)

        if d.get("health") is not None:
            hrow = QHBoxLayout()
            hrow.addWidget(QLabel("Vie restante"))
            bar = QProgressBar()
            bar.setRange(0, 100)
            bar.setValue(d["health"])
            bar.setFormat(f"{d['health']} %")
            hcol = RED if d["health"] <= 10 else ORANGE if d["health"] <= 30 else GREEN
            bar.setStyleSheet(f"QProgressBar::chunk {{ background-color: {hcol}; }}")
            hrow.addWidget(bar, 1)
            v.addLayout(hrow)

        grid = QGridLayout()
        grid.setHorizontalSpacing(16)
        for i, (k, val) in enumerate(d["rows"]):
            grid.addWidget(muted(QLabel(k)), i, 0)
            grid.addWidget(QLabel(html.escape(str(val))), i, 1)
        grid.setColumnStretch(1, 1)
        v.addLayout(grid)
        reasons = QLabel("<br>".join("• " + html.escape(x) for x in d["reasons"]))
        reasons.setWordWrap(True)
        if d["level"] in ("warn", "bad"):
            reasons.setStyleSheet(f"color:{col}")
        v.addWidget(reasons)
        return f

    def update_dash_smart(self):
        if not hasattr(self, "dash_smart") or not self.smart_disks:
            return
        worst = max(self.smart_disks, key=lambda d: {"ok": 0, "info": 0, "warn": 1, "bad": 2}[d["level"]])
        level = worst["level"]
        col = {"ok": GREEN, "warn": ORANGE, "bad": RED}.get(level, BLUE)
        txt = {"ok": "✔ tous les disques sont en bon état", "info": "✔ aucun problème détecté",
               "warn": f"⚠ {worst['model']} est à surveiller",
               "bad": f"✘ {worst['model']} : état critique, sauvegarde tes données !"}[level]
        self.dash_smart.setText(f"<b>Santé des disques :</b> <span style='color:{col}'>"
                                f"{html.escape(txt)}</span> <small>(analyse du {self.smart_date})</small>")

