def muted(label: QLabel) -> QLabel:
    pal = label.palette()
    pal.setColor(QPalette.ColorRole.WindowText, label.palette().color(QPalette.ColorRole.PlaceholderText))
    label.setPalette(pal)
    return label


class Card(QFrame):
    """Tuile du tableau de bord : titre, valeur, détail, bouton optionnel."""

    def __init__(self, icon_name: str, title: str, button: str | None = None, slot=None):
        super().__init__()
        self.setFrameShape(QFrame.Shape.StyledPanel)
        self.setMinimumHeight(140)
        lay = QVBoxLayout(self)
        top = QHBoxLayout()
        ic = QLabel()
        ic.setPixmap(icon(icon_name).pixmap(22, 22))
        t = QLabel(f"<b>{html.escape(title)}</b>")
        top.addWidget(ic)
        top.addWidget(t)
        top.addStretch()
        lay.addLayout(top)
        self.value = QLabel("…")
        f = self.value.font()
        f.setPointSizeF(f.pointSizeF() * 1.9)
        f.setBold(True)
        self.value.setFont(f)
        lay.addWidget(self.value)
        self.detail = muted(QLabel(""))
        self.detail.setWordWrap(True)
        lay.addWidget(self.detail)
        lay.addStretch()
        self.button = None
        if button:
            self.button = QPushButton(button)
            self.button.clicked.connect(slot)
            self.button.setEnabled(False)
            lay.addWidget(self.button, alignment=Qt.AlignmentFlag.AlignLeft)

    def set(self, value: str, detail: str = "", level: str = "ok", action: bool = False):
        color = {"ok": GREEN, "warn": ORANGE, "bad": RED, "info": BLUE}.get(level, "")
        self.value.setText(value)
        self.value.setStyleSheet(f"color:{color}" if color else "")
        self.detail.setText(detail)
        if self.button:
            self.button.setEnabled(action)


