def collect_quick() -> dict:
    d: dict = {}
    osr = {}
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            k, _, v = line.partition("=")
            osr[k] = v.strip().strip('"')
    except OSError:
        pass
    d["os"] = osr.get("PRETTY_NAME", "Linux")
    d["kernel"] = platform.release()
    d["reboot"] = not Path(f"/usr/lib/modules/{d['kernel']}").exists()
    try:
        d["uptime"] = fmt_duration(float(Path("/proc/uptime").read_text().split()[0]))
    except (OSError, ValueError):
        d["uptime"] = "?"
    d["host"] = platform.node()
    d["pkgs"] = len(sh(["pacman", "-Qq"])[1].split())
    d["foreign"] = len(sh(["pacman", "-Qqm"])[1].split())
    d["orphans"] = sh(["pacman", "-Qdtq"])[1].split()
    d["aur_helper"] = aur_helper()
    d["locked"] = Path("/var/lib/pacman/db.lck").exists()

    failed = []
    for scope, prefix in (([], ""), (["--user"], "(utilisateur) ")):
        _, out = sh(["systemctl", *scope, "--failed", "--no-legend", "--plain"])
        failed += [prefix + l.split()[0] for l in out.splitlines() if l.strip()]
    d["failed"] = failed

    _, out = sh("journalctl -b -p 3 -q --no-pager 2>/dev/null | wc -l")
    d["errors"] = int(out.strip() or 0)

    _, out = sh(r"find /etc \( -name '*.pacnew' -o -name '*.pacsave' \) 2>/dev/null")
    d["pacnew"] = out.split()

    disks, seen = [], set()
    try:
        mounts = Path("/proc/mounts").read_text().splitlines()
    except OSError:
        mounts = []
    for line in mounts:
        parts = line.split()
        if len(parts) < 3 or parts[2] not in REAL_FS or parts[0] in seen:
            continue
        mnt = parts[1].replace("\\040", " ")
        try:
            u = shutil.disk_usage(mnt)
        except OSError:
            continue
        seen.add(parts[0])
        disks.append((mnt, parts[2], u.used, u.total))
    d["disks"] = disks

    d["pkgcache"] = dir_size("/var/cache/pacman/pkg")
    d["usercache"] = dir_size(HOME_CACHE)
    d["thumbs"] = dir_size(HOME_CACHE / "thumbnails")
    d["aur_cache_dir"] = next((HOME_CACHE / h for h in ("paru/clone", "yay")
                               if (HOME_CACHE / h).is_dir()), None)
    d["aur_cache"] = dir_size(d["aur_cache_dir"]) if d["aur_cache_dir"] else 0
    _, out = sh(["journalctl", "--disk-usage"])
    m = re.search(r"take up ([\d.,]+\s*\S+)", out)
    d["journal"] = m.group(1) if m else "?"
    d["last_run"] = LAST_RUN.read_text().strip() if LAST_RUN.exists() else None
    d["btrfs"] = sh(["findmnt", "-t", "btrfs", "/"])[0] == 0
    d["snap_tool"] = "snapper" if have("snapper") else ("timeshift" if have("timeshift") else None)
    return d


def collect_slow() -> dict:
    d: dict = {"updates": [], "updates_error": None}
    if have("checkupdates"):
        rc, out = sh(["checkupdates"], timeout=180)
        if rc == 1:
            d["updates_error"] = "checkupdates a échoué (réseau ?)"
        d["updates"] += parse_updates(out, "Dépôts")
    else:
        d["updates_error"] = "checkupdates absent (installe pacman-contrib)"
    h = aur_helper()
    if h:
        _, out = sh([h, "-Qua"], timeout=180)
        d["updates"] += parse_updates(out, "AUR")
    if have("flatpak"):
        _, out = sh(["flatpak", "remote-ls", "--updates", "--columns=application,version"], timeout=120)
        for line in out.splitlines():
            cols = line.split("\t")
            if cols and cols[0] and "." in cols[0]:
                d["updates"].append((cols[0], "", cols[1] if len(cols) > 1 else "", "Flatpak"))
    return d


