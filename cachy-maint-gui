def read(path, default: str = "") -> str:
    try:
        return Path(path).read_text(errors="replace").strip()
    except OSError:
        return default


def size_iec(n: int | float | None) -> str:
    """Taille lisible, en puissances de 1024 (« Go » = Gio comme le fait KDE)."""
    return human(n) if n else "?"


def clean_pci_name(name: str) -> str:
    return re.sub(r"\s*\(rev \w+\)$", "", name).strip()


