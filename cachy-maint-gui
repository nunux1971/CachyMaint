    def on_data(self, d: dict):
        self.data.update(d)
        if "os" in d:
            self.show_quick(d)
        if "updates" in d:
            self.show_updates(d)

    def show_quick(self, d):
        self.dash_sub.setText(f"{d['os']} • {d['host']} • noyau {d['kernel']} • allumé depuis "
                              f"{d['uptime']} • {d['pkgs']} paquets ({d['foreign']} AUR/externes)")
        n = len(d["orphans"])
        self.c_orph.set(str(n), ", ".join(d["orphans"][:6]) + ("…" if n > 6 else "") if n
                        else "Rien à supprimer", "warn" if n else "ok", bool(n))
        n = len(d["failed"])
        self.c_fail.set(str(n), ", ".join(d["failed"][:4]) if n else "Tout fonctionne",
                        "bad" if n else "ok", bool(n))
        n = d["errors"]
        self.c_err.set(str(n), "lignes d'erreur depuis le démarrage",
                       "ok" if n == 0 else ("warn" if n < 50 else "bad"), bool(n))
        n = len(d["pacnew"])
        self.c_pacnew.set(str(n), "\n".join(Path(p).name for p in d["pacnew"][:3]) if n
                          else "Configuration à jour", "warn" if n else "ok", bool(n))
        size = d["pkgcache"] or 0
        self.c_cache.set(human(size), "/var/cache/pacman/pkg",
                         "warn" if size > 5 * 1024 ** 3 else "info", size > 0)
        if d["reboot"]:
            self.c_reboot.set("Conseillé", "Un nouveau noyau est installé.", "warn")
        else:
            self.c_reboot.set("Inutile", f"Noyau {d['kernel']} à jour.", "ok")
        if d["last_run"]:
            try:
                days = (dt.date.today() - dt.date.fromisoformat(d["last_run"])).days
            except ValueError:
                days = 0
            self.c_last.set(f"{days} j" if days else "Aujourd'hui", f"le {d['last_run']}",
                            "ok" if days <= 14 else ("warn" if days <= 45 else "bad"))
        else:
            self.c_last.set("Jamais", "Lance une maintenance complète.", "warn")
        if d["locked"]:
            self.write("⚠ Verrou pacman présent : si aucune mise à jour ne tourne, "
                       "utilise Diagnostic → Déverrouiller pacman.", "err")

        # Espace disque
        while self.disk_box.count():
            item = self.disk_box.takeAt(0)
            if item.layout():
                while item.layout().count():
                    sub = item.layout().takeAt(0)
                    if sub.widget():
                        sub.widget().deleteLater()
            elif item.widget():
                item.widget().deleteLater()
        for mnt, fs, used, total in d["disks"]:
            pct = int(used * 100 / total) if total else 0
            row = QHBoxLayout()
            name = QLabel(f"<b>{html.escape(mnt)}</b> <small>({fs})</small>")
            name.setMinimumWidth(200)
            bar = QProgressBar()
            bar.setRange(0, 100)
            bar.setValue(pct)
            bar.setFormat(f"{pct} %")
            col = RED if pct >= 90 else (ORANGE if pct >= 80 else GREEN)
            bar.setStyleSheet(f"QProgressBar::chunk {{ background-color: {col}; }}")
            info = QLabel(f"{human(used)} / {human(total)}")
            info.setMinimumWidth(150)
            info.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
            row.addWidget(name)
            row.addWidget(bar, 1)
            row.addWidget(info)
            self.disk_box.addLayout(row)

        # Infos de la page Nettoyage
        self.r_cache.info.setText(human(d["pkgcache"]))
        self.r_orph.info.setText(f"{len(d['orphans'])} paquet(s)")
        self.r_journal.info.setText(d["journal"])
        self.r_thumbs.info.setText(human(d["thumbs"]))
        self.r_old.info.setText(f"~/.cache : {human(d['usercache'])}")
        self.r_aur.info.setText(human(d["aur_cache"]) if d["aur_cache_dir"] else "—")
        self.r_aur.button.setEnabled(bool(d["aur_cache_dir"]))

    def show_updates(self, d):
        ups = d["updates"]
        self.upd_tree.clear()
        for name, old, new, src in ups:
            it = QTreeWidgetItem([name, old, new, src])
            it.setIcon(0, icon({"AUR": "package-x-generic", "Flatpak": "flatpak-discover"}
                               .get(src, "package"), "package-x-generic"))
            self.upd_tree.addTopLevelItem(it)
        for i in (1, 2, 3):
            self.upd_tree.resizeColumnToContents(i)
        by = {s: sum(1 for u in ups if u[3] == s) for s in ("Dépôts", "AUR", "Flatpak")}
        detail = " • ".join(f"{v} {k}" for k, v in by.items() if v) or "Système à jour"
        if d["updates_error"]:
            detail += f"\n⚠ {d['updates_error']}"
        self.c_upd.set(str(len(ups)), detail,
                       "bad" if d["updates_error"] and not ups else ("warn" if ups else "ok"),
                       bool(by["Dépôts"] or by["Flatpak"]))
        self.upd_info.setText(f"{len(ups)} mise(s) à jour disponible(s) — {detail}  "
                              f"(vérifié à {dt.datetime.now():%H:%M})")

    # --------------------------------------------------------------- console
    def write(self, text: str, kind: str = "out"):
        cur = self.console.textCursor()
        cur.movePosition(QTextCursor.MoveOperation.End)
        fmt = QTextCharFormat()
        if kind != "out":
            if not self._nl:
                cur.insertText("\n")
            fmt.setForeground(QColor({"ok": GREEN, "err": RED, "info": BLUE,
                                      "title": BLUE}.get(kind, BLUE)))
            if kind == "title":
                fmt.setFontWeight(QFont.Weight.Bold)
            text = text + "\n"
        cur.insertText(text, fmt)
        self._nl = text.endswith("\n")
        self.console.setTextCursor(cur)
        self.console.ensureCursorVisible()

    def on_busy(self, busy: bool, label: str):
        self.progress.setRange(0, 0 if busy else 1)
        self.stop_btn.setEnabled(busy)
        self.full_btn.setEnabled(not busy)
        self.status.setText(label if busy else "Prêt.")

    def on_done(self, ok: bool):
        cb, self.after_done = self.after_done, None
        if cb:
            cb(ok)
        self.refresh()

    # ----------------------------------------------------------- exécution
    def run(self, title: str, steps: list[Step], after=None) -> bool:
        if any(s.root for s in steps) and not Path(HELPER).exists():
            QMessageBox.warning(self, APP_NAME, "Le module administrateur n'est pas installé. "
                                                "Lance install.sh.")
            return False
        if self.runner.busy():
            QMessageBox.information(self, APP_NAME, "Une opération est déjà en cours.")
            return False
        self.after_done = after
        return self.runner.start(title, steps)

    def confirm(self, title: str, text: str) -> bool:
        return QMessageBox.question(self, title, text) == QMessageBox.StandardButton.Yes

    def in_terminal(self, title: str, command: str):
        term = find_terminal()
        if not term:
            QMessageBox.warning(self, APP_NAME, "Aucun terminal trouvé (konsole, kitty…).")
            return
        script = (f'echo -e "\\e[1;36m━━━ {title} ━━━\\e[0m"; {command}; echo; '
                  f'read -rp "Terminé. Appuie sur Entrée pour fermer…"')
        p = QProcess(self)
        p.finished.connect(lambda *_: (self.terminals.remove(p) if p in self.terminals else None,
                                       self.refresh()))
        self.terminals.append(p)
        self.write(f"➜ {title} : ouvert dans un terminal", "info")
        log_line(f"TERMINAL {command}")
        p.start(term[0], term[1:] + ["bash", "-c", script])

    # --------------------------------------------------------------- actions
    def full_maintenance(self):
        steps_txt = ["Instantané de sécurité (si snapper ou Timeshift)",
                     "Mise à jour des dépôts officiels",
                     "Suppression des paquets orphelins",
                     "Nettoyage du cache des paquets",
                     "Réduction des journaux système"]
        steps = [Step("Maintenance système (administrateur)", ["full"], root=True)]
        if have("flatpak"):
            steps_txt.append("Mise à jour et nettoyage des Flatpak")
            steps += [Step("Mise à jour Flatpak", ["flatpak", "update", "-y", "--noninteractive"],
                           stop_on_fail=False),
                      Step("Flatpak inutilisés", ["flatpak", "uninstall", "--unused", "-y",
                                                  "--noninteractive"], stop_on_fail=False)]
        if not self.confirm("Maintenance complète",
                            "Étapes prévues :\n\n• " + "\n• ".join(steps_txt) +
                            "\n\nTon mot de passe sera demandé. Continuer ?"):
            return
        self.run("Maintenance complète", steps, after=self._after_full)

    def _after_full(self, ok: bool):
        if not ok:
            self.write("La maintenance ne s'est pas terminée correctement : consulte la console "
                       "ci-dessus. Tu peux réessayer avec « Tout dans un terminal ».", "err")
            return
        LAST_RUN.write_text(dt.date.today().isoformat())
        self.write("✔ Maintenance complète terminée.", "ok")
        aur = [u for u in self.data.get("updates", []) if u[3] == "AUR"]
        if aur and self.confirm("AUR", f"{len(aur)} paquet(s) AUR peuvent être mis à jour.\n"
                                       "Les mettre à jour maintenant dans un terminal ?"):
            self.update_aur()
        if not Path(f"/usr/lib/modules/{platform.release()}").exists():
            QMessageBox.information(self, APP_NAME, "Un nouveau noyau a été installé.\n"
                                                    "Redémarre l'ordinateur pour l'utiliser.")

    def update_system(self):
        steps = [Step("Mise à jour des dépôts", ["update"], root=True)]
        if have("flatpak"):
            steps.append(Step("Mise à jour Flatpak", ["flatpak", "update", "-y", "--noninteractive"],
                              stop_on_fail=False))
        self.run("Mise à jour du système", steps)

    def update_aur(self):
        h = aur_helper()
        if not h:
            QMessageBox.information(self, APP_NAME, "Aucun assistant AUR (paru ou yay) installé.")
            return
        self.in_terminal("Mise à jour AUR", f"{h} -Sua")

    def update_terminal(self):
        h = aur_helper()
        cmd = f"{h} -Syu" if h else "sudo pacman -Syu"
        if have("flatpak"):
            cmd += " && flatpak update"
        self.in_terminal("Mise à jour complète", cmd)

    def rate_mirrors(self):
        self.run("Classement des miroirs", [Step("Test des miroirs (1 à 2 minutes)", ["mirrors"], root=True)])

    def firmware(self):
        if not have("fwupdmgr"):
            QMessageBox.information(self, APP_NAME, "fwupd n'est pas installé :\nsudo pacman -S fwupd")
            return
        self.run("Micrologiciels", [
            Step("Actualisation des métadonnées", ["fwupdmgr", "refresh", "--force"], stop_on_fail=False),
            Step("Recherche de mises à jour", ["fwupdmgr", "get-updates"], ok_codes=(0, 2)),
        ], after=self._firmware_after)

    def _firmware_after(self, ok):
        if ok and self.confirm("Micrologiciels", "Si des mises à jour sont listées dans la console, "
                                                 "les installer maintenant ?"):
            QTimer.singleShot(0, lambda: self.run("Installation des micrologiciels", [
                Step("Installation", ["fwupdmgr", "update", "-y", "--no-reboot-check"], ok_codes=(0, 2))]))

    def clean_cache(self):
        self.run("Nettoyage du cache des paquets", [Step("paccache", ["clean-cache"], root=True)])

    def remove_orphans(self):
        orph = self.data.get("orphans", [])
        if not orph:
            QMessageBox.information(self, APP_NAME, "Aucun paquet orphelin.")
            return
        if self.confirm("Paquets orphelins", f"Supprimer ces {len(orph)} paquet(s) ?\n\n" +
                        ", ".join(orph[:40]) + ("…" if len(orph) > 40 else "")):
            self.run("Suppression des orphelins", [Step("pacman -Rns", ["orphans"], root=True)])

    def clean_journal(self):
        self.run("Réduction des journaux", [Step("journalctl --vacuum", ["journal"], root=True)])

    def clean_thumbs(self):
        t = HOME_CACHE / "thumbnails"
        if not t.is_dir():
            QMessageBox.information(self, APP_NAME, "Pas de miniatures à supprimer.")
            return
        self.run("Miniatures", [Step("Suppression des miniatures",
                                     ["find", str(t), "-type", "f", "-delete"])])

    def clean_old_cache(self):
        if self.confirm("Cache personnel", "Supprimer les fichiers de ~/.cache non lus depuis "
                                           "plus de 90 jours ?\nLes applications les recréeront "
                                           "si nécessaire."):
            self.run("Cache personnel ancien", [
                Step("Fichiers anciens", ["find", str(HOME_CACHE), "-xdev", "-type", "f",
                                          "-atime", "+90", "-print", "-delete"], stop_on_fail=False,
                     ok_codes=(0, 1)),
                Step("Dossiers vides", ["find", str(HOME_CACHE), "-xdev", "-mindepth", "1",
                                        "-type", "d", "-empty", "-delete"], ok_codes=(0, 1))])

    def clean_aur_cache(self):
        d = self.data.get("aur_cache_dir")
        if d and self.confirm("Cache AUR", f"Vider {d} ?\nLes sources seront retéléchargées "
                                           "à la prochaine mise à jour AUR."):
            self.run("Cache AUR", [Step("Suppression", ["bash", "-c",
                                                        'shopt -s dotglob nullglob; rm -rf -- "$1"/*',
                                                        "_", str(d)])])

    def clean_flatpak(self):
        self.run("Flatpak inutilisés", [Step("flatpak uninstall --unused",
                                             ["flatpak", "uninstall", "--unused", "-y", "--noninteractive"])])

    def show_failed(self):
        self.run("Services en échec", [
            Step("Services système", ["systemctl", "--failed", "--no-pager"]),
            Step("Services utilisateur", ["systemctl", "--user", "--failed", "--no-pager"])])

    def show_errors(self):
        self.run("Erreurs du journal", [Step("Erreurs depuis le démarrage (100 dernières)",
                                             ["journalctl", "-b", "-p", "3", "-q", "--no-pager",
                                              "-n", "100"])])

    def smart(self):
        self.goto("Santé des disques")
        if not self.smart_disks:
            self.analyze_disks()

    def goto(self, name: str):
        for i in range(self.nav.count()):
            if self.nav.item(i).text() == name:
                self.nav.setCurrentRow(i)
                return

    def btrfs_status(self):
        self.run("État Btrfs", [Step("btrfs", ["btrfs"], root=True)])

    def verify_packages(self):
        self.run("Intégrité des paquets", [
            Step("Fichiers manquants", ["bash", "-c",
                                        "pacman -Qk 2>/dev/null | grep -v ' 0 missing files' "
                                        "|| echo 'Aucun fichier manquant.'"]),
            Step("Dépendances", ["pacman", "-Dk"], stop_on_fail=False)])

    def merge_pacnew(self):
        if not have("pacdiff"):
            QMessageBox.information(self, APP_NAME, "pacdiff absent : sudo pacman -S pacman-contrib")
            return
        files = self.data.get("pacnew", [])
        if not files:
            QMessageBox.information(self, APP_NAME, "Aucun fichier .pacnew ou .pacsave.")
            return
        diff = "meld" if have("meld") else ("kompare" if have("kompare") else "vimdiff")
        self.in_terminal("Fusion des fichiers de configuration",
                         f"sudo DIFFPROG={diff} pacdiff")

    def big_packages(self):
        script = ("LC_ALL=C pacman -Qi | awk -F': ' '/^Name/{n=$2} /^Installed Size/{split($2,a,\" \");"
                  "m=(a[2]==\"KiB\")?1/1024:(a[2]==\"GiB\")?1024:(a[2]==\"B\")?1/1048576:1;"
                  "printf \"%9.1f Mo  %s\\n\", a[1]*m, n}' | sort -rn | head -25")
        self.run("Paquets les plus volumineux", [Step("pacman -Qi", ["bash", "-c", script])])

    def reset_failed(self):
        self.run("Services", [Step("systemctl reset-failed", ["reset-failed"], root=True)])

    def unlock(self):
        if self.confirm("Déverrouiller pacman", "Supprimer le verrou de pacman ?\n"
                                                "(refusé automatiquement si une mise à jour tourne)"):
            self.run("Verrou pacman", [Step("Déverrouillage", ["unlock"], root=True)])

    def snapshot(self):
        self.run("Instantané", [Step("Création", ["snapshot"], root=True)])

    def snapshot_list(self):
        self.run("Instantanés", [Step("Liste", ["snapshot-list"], root=True)])

    def scrub(self):
        if self.confirm("Vérification Btrfs", "Lancer la vérification complète du disque système ?\n"
                                              "Elle dure de quelques minutes à une heure selon "
                                              "la taille et tourne en arrière-plan."):
            self.run("Scrub Btrfs", [Step("btrfs scrub start", ["scrub"], root=True)])

    def closeEvent(self, e):
        if self.runner.busy() and not self.confirm(APP_NAME, "Une opération est en cours. "
                                                             "Quitter quand même ?"):
            e.ignore()
            return
        e.accept()


def main():
    if os.geteuid() == 0:
        print("Lance Cachy Maint en utilisateur normal : il demandera le mot de passe au besoin.")
        sys.exit(1)
    app = QApplication(sys.argv)
    app.setApplicationName(APP_NAME)
    app.setApplicationVersion(VERSION)
    app.setDesktopFileName("cachy-maint")
    if not have("pacman"):
        QMessageBox.critical(None, APP_NAME, "pacman introuvable : Cachy Maint est prévu pour "
                                             "CachyOS / Arch Linux.")
        sys.exit(1)
    w = MainWindow()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
