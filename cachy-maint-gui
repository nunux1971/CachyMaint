class Step:
    def __init__(self, label: str, argv: list[str], root: bool = False,
                 stop_on_fail: bool = True, ok_codes: tuple = (0,)):
        self.label, self.argv, self.root = label, argv, root
        self.stop_on_fail, self.ok_codes = stop_on_fail, ok_codes


class Runner(QObject):
    output = Signal(str, str)     # texte, genre : out / info / ok / err / title
    busy_changed = Signal(bool, str)
    done = Signal(bool)

    def __init__(self):
        super().__init__()
        self.proc: QProcess | None = None
        self.queue: list[Step] = []
        self.current: Step | None = None
        self.ok = True

    def busy(self) -> bool:
        return self.proc is not None or bool(self.queue)

    def start(self, title: str, steps: list[Step]) -> bool:
        if self.busy():
            return False
        self.queue, self.ok = list(steps), True
        self.output.emit(f"━━━ {title} — {dt.datetime.now():%H:%M} ━━━", "title")
        log_line(f"===== {title} =====")
        self._next()
        return True

    def stop(self):
        self.queue.clear()
        if self.proc is None:
            return
        if self.current and self.current.root:
            self.output.emit("La tâche administrateur en cours va se terminer d'elle-même ; "
                             "les étapes suivantes sont annulées.", "info")
        else:
            self.proc.kill()
            self.output.emit("Tâche interrompue.", "err")

    def _next(self):
        if not self.queue:
            self.proc, self.current = None, None
            self.busy_changed.emit(False, "")
            self.done.emit(self.ok)
            return
        s = self.current = self.queue.pop(0)
        argv = ["pkexec", HELPER, *s.argv] if s.root else s.argv
        self.output.emit(f"➜ {s.label}", "info")
        log_line(f"CMD {' '.join(argv)}")
        self.busy_changed.emit(True, s.label)
        p = QProcess(self)
        p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        env = QProcessEnvironment.systemEnvironment()
        env.insert("TERM", "dumb")
        env.insert("NO_COLOR", "1")
        p.setProcessEnvironment(env)
        p.readyReadStandardOutput.connect(self._read)
        p.finished.connect(self._finished)
        p.errorOccurred.connect(self._error)
        self.proc = p
        p.start(argv[0], argv[1:])

    def _read(self):
        if not self.proc:
            return
        text = bytes(self.proc.readAllStandardOutput()).decode("utf-8", "replace")
        text = ANSI_RE.sub("", text).replace("\r\n", "\n").replace("\r", "\n")
        if text:
            self.output.emit(text, "out")
            log_line(text)

    def _finished(self, code: int, status):
        s = self.current
        self._read()
        if status == QProcess.ExitStatus.CrashExit or code not in s.ok_codes:
            if s.root and code in (126, 127):
                msg = f"✘ {s.label} : authentification annulée ou refusée."
            else:
                msg = f"✘ {s.label} : échec (code {code})."
            self.output.emit(msg, "err")
            log_line(msg)
            self.ok = False
            if s.stop_on_fail:
                self.queue.clear()
        else:
            self.output.emit(f"✔ {s.label}", "ok")
            log_line(f"OK {s.label}")
        if self.proc:
            self.proc.deleteLater()
        self.proc = None
        self._next()

    def _error(self, err):
        if err == QProcess.ProcessError.FailedToStart:
            self.output.emit(f"✘ Impossible de lancer « {self.current.argv[0]} ».", "err")
            self.ok = False
            self.queue.clear()
            if self.proc:
                self.proc.deleteLater()
            self.proc = None
            self._next()


